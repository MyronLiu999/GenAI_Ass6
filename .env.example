# Copy to .env (git-ignored) and fill in the key for the provider named in settings.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing of every LangGraph/LangChain call, on top of EquityDesk's own traces.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=equitydesk

# Windows: keep Python in UTF-8 mode.
PYTHONUTF8=1
